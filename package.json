{
  "name": "naukar-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "yarn workspace @naukar/frontend run dev",
    "dev:web": "yarn workspace @naukar/frontend run dev:vite",
    "dev:frontend": "yarn workspace @naukar/frontend run dev",
    "dev:backend": "powershell -Command \"cd backend; .\\.venv\\Scripts\\uvicorn main:app --reload --host 0.0.0.0 --port 8000\"",
    "build": "yarn workspace @naukar/frontend run build",
    "typecheck": "yarn workspace @naukar/frontend run typecheck"
  }
}

