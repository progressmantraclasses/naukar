# =============================================================================
# NAUKAR — Autonomous AI Workforce Platform
# Environment Configuration
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://naukar:naukar_secret@localhost:5432/naukar_db
DATABASE_SYNC_URL=postgresql://naukar:naukar_secret@localhost:5432/naukar_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j AuraDB ---
NEO4J_URI=neo4j+s://YOUR_AURADB_URI.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_AURADB_PASSWORD

# --- LLM Providers ---
GROQ_API_KEY=your_groq_api_key_here

# --- Model Configuration ---
# Available: groq/compound, groq/compound-mini, openai/gpt-oss-120b, etc.
DEFAULT_FAST_MODEL=groq/compound-mini
DEFAULT_SMART_MODEL=groq/compound
DEFAULT_HEAVY_MODEL=openai/gpt-oss-120b

# --- Groq Model Mappings ---
GROQ_COMPOUND_MODEL=openai/gpt-oss-120b
GROQ_COMPOUND_MINI_MODEL=groq/compound-mini

# --- App Settings ---
APP_NAME=Naukar
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- Task Settings ---
MAX_TASK_COST_USD=5.0
DEFAULT_QUALITY_THRESHOLD=0.80
MAX_RETRY_ATTEMPTS=3
MAX_EMPLOYEES_PER_TASK=12
GROQ_MAX_OUTPUT_TOKENS=1800
CHEAP_MAX_OUTPUT_TOKENS=900
STANDARD_MAX_OUTPUT_TOKENS=1800
REASONING_MAX_OUTPUT_TOKENS=2600
LLM_CACHE_TTL_SECONDS=86400
MONTHLY_USER_BUDGET_USD=10.0
SEMANTIC_CACHE_THRESHOLD=0.92
LLM_CONTEXT_TOKENS=6000
RAG_TOP_K=5
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=20
SEARCH_CACHE_TTL_SECONDS=3600
LLM_REQUESTS_PER_MINUTE=60
TOOL_WORKSPACE_ROOT=.
MAX_STEPS=12
MAX_TOOL_CALLS=20
MAX_REPEAT_ACTIONS=2
MAX_RUNTIME_SECONDS=900
TASK_QUEUE_MODE=background
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AUTH_REQUIRED=false
AUTH_TOKEN=
AUTH_DEFAULT_USER_ID=anonymous
AUTH_DEFAULT_WORKSPACE_ID=default
MODEL_PRICING_JSON={"groq/compound-mini":{"input":0.075,"output":0.30,"cached_input":0.0},"openai/gpt-oss-120b":{"input":0.15,"output":0.60,"cached_input":0.0}}

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
